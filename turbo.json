{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "globalEnv": [
    "OLLAMA_BASE_URL",
    "OLLAMA_MODEL",
    "OLLAMA_ENABLED",
    "LANGFUSE_BASEURL",
    "ROSE_DAILY_LIMIT_GUEST",
    "ROSE_WEEKLY_LIMIT_GUEST",
    "ROSE_DAILY_LIMIT_USER",
    "ROSE_WEEKLY_LIMIT_USER",
    "FASTER_WHISPER_MODEL_PATH",
    "FASTER_WHISPER_DEVICE",
    "FASTER_WHISPER_COMPUTE_TYPE",
    "REDIS_URL",
    "SUPABASE_SECRET_KEY",
    "GEMINI_API_KEY",
    "SERPAPI_KEY",
    "GROQ_API_KEY",
    "LANGFUSE_SECRET_KEY",
    "AI_GATEWAY_API_KEY",
    "AI_GATEWAY_MODEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "build:mobile": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "cap:sync": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:style": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
