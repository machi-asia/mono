# ==========================================
# Non-Config Keys (Credentials & API Secrets)
# ==========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Google Gemini API (Server-side only — never exposed to client)
GEMINI_API_KEY=your-gemini-api-key

# Search Provider (Server-side only — optional for webSearch tool)
SERPAPI_KEY=your-serpapi-key

# Groq API (Server-side only — tool output processing and synthesis)
GROQ_API_KEY=your-groq-api-key

# Langfuse Observability & Tracing (Server-side only)
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key

# ==========================================
# Configuration Keys (Settings, Tiers, Models)
# ==========================================

# Model Configuration
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=qwen/qwen3.8-27b

# Langfuse Configuration
LANGFUSE_BASEURL=https://us.cloud.langfuse.com

# Rose Usage Limits
ROSE_DAILY_LIMIT_GUEST=10
ROSE_WEEKLY_LIMIT_GUEST=50
ROSE_DAILY_LIMIT_USER=20
ROSE_WEEKLY_LIMIT_USER=200

# Faster Whisper Speech-to-Text Configuration
FASTER_WHISPER_MODEL_PATH=tiny.en
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

