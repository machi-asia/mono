# ==========================================
# Non-Config Keys (Credentials & API Secrets)
# ==========================================

# Supabase
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Search Provider
SERPAPI_KEY=your-serpapi-key

# Groq API
GROQ_API_KEY=your-groq-api-key

# Langfuse Observability
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key

# Redis (Sync Engine)
REDIS_URL=redis://localhost:6379

# ==========================================
# Configuration Keys (Settings, Tiers, Models)
# ==========================================

# Server Port
PORT=3005

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Model Configuration
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_ENABLED=auto

# Langfuse Configuration
LANGFUSE_BASEURL=https://us.cloud.langfuse.com

# Rose Usage Limits
ROSE_DAILY_LIMIT_GUEST=10
ROSE_WEEKLY_LIMIT_GUEST=50
ROSE_DAILY_LIMIT_USER=20
ROSE_WEEKLY_LIMIT_USER=200

# Faster Whisper STT
FASTER_WHISPER_MODEL_PATH=tiny.en
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
