# ==========================================
# Non-Config Keys (Credentials & API Secrets)
# ==========================================

# Supabase
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Redis (Optional, defaults to in-memory store if unset)
REDIS_URL=redis://localhost:6379

# ==========================================
# Configuration Keys (Settings, Tiers, Models)
# ==========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Site URL (public production domain — used for SEO metadataBase, canonical URLs, and sitemap)
NEXT_PUBLIC_SITE_URL=https://forge.machi-asia.com
